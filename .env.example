# Environment configuration template for deadletter_mailproject
# Copy to .env or load into systemd/production environment. Do not commit actual secrets.

# Required in production (at least 50 chars, no django-insecure- prefix)
DJANGO_SECRET_KEY=replace-with-a-random-50-character-secret-key-at-least-5-unique-chars

# Must be false in production
DJANGO_DEBUG=false

# Comma-separated list of fully qualified domain names or IPs without schemes/paths/wildcards
DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Set to true when running behind a trusted reverse proxy (e.g. Nginx, AWS ALB)
DJANGO_TRUST_PROXY_HTTPS=true

# Absolute filesystem paths for static files, media uploads, and SQLite database
DJANGO_STATIC_ROOT=/var/www/deadletter/staticfiles
DJANGO_MEDIA_ROOT=/var/www/deadletter/media
DJANGO_DB_PATH=/var/www/deadletter/db.sqlite3
